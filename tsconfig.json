{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      /*
      //* @env경로를 못찾는 문제 발생
      > 해당 경로 추가
      > 근거 자료는 구글링하다 한 질문자의 코드를 보고 판단
      > 정환한 근거가 아니므로 검토 필요
      > //?출처: https://stackoverflow.com/questions/71712037/cannot-find-module-env-or-its-corresponding-type-declarations
      */
      "@env": ["node_modules/react-native-dotenv"],

      "#components": ["./app/components/index"],
      "#models": ["./app/models/index"],
      "#navigators": ["./app/navigators/index"],
      "#screens": ["./app/screens/index"],
      "#theme": ["./app/theme/index"],
      "#LEGACY_api": ["app/services/LEGACY_api/index"],
      "#api": ["app/services/api/index"],
      "#images": ["./assets/images/index"],
      "#fonts": ["./assets/fonts/index"],

      "react": ["./node_modules/@types/react"]

      //* 예외들
      //! storybook 은 절대로 절대경로 설정하지 말것!
    },
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "jsx": "react-native",
    "module": "es2015",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "babel.config.js"],
  "include": ["App.js", "app", "test", "storybook", "react-native-config.d.ts"],
  "extends": "expo/tsconfig.base"
}
